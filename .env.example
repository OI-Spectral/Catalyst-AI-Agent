# Copy to .env and fill in. CLI.py, app.py and evals/run_evals.py read it automatically.
ANTHROPIC_API_KEY=

# Search provider: free (default, no key: searches SEP, IEP and Wikipedia directly), tavily or brave
SEARCH_PROVIDER=free
SEARCH_API_KEY=

# Spend cap per run, in dollars
MAX_RUN_COST_USD=5.00

# Optional guardrails; these are the defaults
# MAX_TOOL_CALLS=15
# TOOL_TIMEOUT_S=30
# RUN_TIMEOUT_S=900
# MAX_RETRIES=2
# MAX_REVISIONS=3
